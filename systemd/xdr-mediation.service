[Unit]
Description=xDR mediation simulator - push one NORMAL batch to S3
After=network-online.target

[Service]
Type=oneshot
User=xdr-demo
WorkingDirectory=/opt/xdr-source
EnvironmentFile=/etc/xdr-demo.env
ExecStart=/opt/xdr-source/.venv/bin/python /opt/xdr-source/xdr_source.py --rows 8000 --s3 s3://${XDR_BUCKET}/xdr
