# Copy to .env.clickzetta (git-ignored) and fill in your own values.
# cz-cli profile inputs (from Studio > Connect to Lakehouse)
CZ_SERVICE=<region>.api.singdata.com
CZ_INSTANCE=
CZ_WORKSPACE=
CZ_VCLUSTER=DEFAULT
CZ_SCHEMA=xdr_demo
CZ_USERNAME=
CZ_PASSWORD=
# PAT for cz-cli / ClickZetta API auth
CZ_PAT=
# read-only identity for the agent (create in Phase 3 / T6)
CZ_AGENT_USERNAME=
CZ_AGENT_PASSWORD=
# AWS uploader credentials. Use a bucket-scoped identity.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
XDR_BUCKET=

# Optional consumer agent (OpenAI-compatible endpoint)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
